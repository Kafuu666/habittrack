# Salin file ini menjadi .env lalu sesuaikan nilainya
NODE_ENV=development
PORT=3000

# Database MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=habittrack_db

# JWT (WAJIB diganti; contoh membuat secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=ganti-dengan-secret-acak-yang-panjang
JWT_EXPIRES_IN=7d

# Zona waktu acuan server untuk menentukan "hari ini" bila aplikasi tidak mengirim tanggal perangkat
APP_TIMEZONE=Asia/Jakarta

# Origin yang diizinkan CORS ("*" untuk pengembangan)
CORS_ORIGIN=*
